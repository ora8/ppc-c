program Misc;
type
  TArr5 = array[1..5] of Integer;
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TAccount = class {
  private
    FBalance: Integer;
    FLog: String;
    proc SetBalance(V: Integer);
  public
    property Balance: Integer read FBalance write SetBalance;
    property Log: String read FLog;
    proc Apply(n: Integer);
  }
  TRec = class { A, B: Integer; Name: String; }

proc TAccount.SetBalance(V: Integer)
{
  FLog := FLog + '[' + IntToStr(V) + ']';
  FBalance := V;
}

proc TAccount.Apply(n: Integer);
  proc Step(k: Integer)          {* nested in a method, access to Self *}
  {
    Balance := Balance + k;
  }
val i: Integer := default;
{
  for i := 1 to n do Step(i);
}

func IsWeekend(d: TDay): Boolean; forward;

func Describe(d: TDay): String
{
  case d of {
    Mon..Fri: Result := 'weekday';
  else
    Result := 'weekend';
  };
  if IsWeekend(d) then Result := Result + '!';
}

func IsWeekend(d: TDay): Boolean
{
  IsWeekend := d >= Sat;
}

func FirstNeg(a: TArr5 const): Integer;
val i: Integer := default;
{
  for i := 1 to 5 do
    if a[i] < 0 then Exit(i);
  Result := -1;
}

func Outer(x: Integer): Integer;
val depth: Integer := default;
  func Mid(y: Integer): Integer;
    func Inner(z: Integer): Integer
    {
      depth := depth + 1;
      Inner := x + y + z;     {* reaches two levels outwards *}
    }
  {
    Mid := Inner(y * 2);
  }
{
  depth := 0;
  Result := Mid(x) * 10 + depth;
}

vao
  acc: TAccount := TAccount.Create;
  p: TRec := TRec.Create;
val
  d: TDay := default;
  arr: TArr5 := default;
  s, t: String := default;
  i: Integer := default;
{

  acc.Balance := 100;
  acc.Apply(3);
  WriteLn('Kontostand: ', acc.Balance, ' Log: ', acc.Log);

  for d := Mon to Sun do WriteLn(d, ': ', Describe(d), ' ord=', Ord(d));
  WriteLn('Succ(Mon)=', Succ(Mon), ' High=', High(TDay));


  p.A := 1; p.B := 2; p.Name := 'rec';
  WriteLn(p.Name, ' ', p.A + p.B, ' ', p.B);

  arr[1] := 3; arr[2] := 1; arr[3] := -4; arr[4] := 1; arr[5] := -5;
  WriteLn('first negative at index ', FirstNeg(arr));
  WriteLn('Outer(2) = ', Outer(2));

  s := 'Hello World';
  t := s;
  Delete(t, 1, 6);
  Insert('nice ', s, 7);
  WriteLn(s, ' | ', t, ' | ', UpperCase(t), ' | ', LowerCase('ABC'));
  case t of {
    'Welt': WriteLn('String-case ok');
  else WriteLn('string case wrong');
  };
  Str(3.14159:0:2, s);
  WriteLn('Str: ', s, ' Round(2.5)=', Round(2.5), ' Trunc(-2.7)=', Trunc(-2.7));
  i := StrToInt('123') + 1;
  WriteLn(i, ' ', 'x':5, '|', 42:6, '|', True:6, '|');
  WriteLn('End');
}
