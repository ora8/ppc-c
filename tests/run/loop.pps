program Endless;
{* loop <statement>: endless loop, left with Break, Exit or try *}
type
  TK = class {
    N: Integer;
    constructor Create(AN: Integer);
    destructor Destroy; override;
  }
constructor TK.Create(AN: Integer); { inherited Create; N := AN; }
destructor TK.Destroy; { WriteLn('  freed ', N); inherited Destroy; }

function FirstSquareAbove(g: Integer): Integer;
val i := 1;
{
  loop
    {
      if i * i > g Exit(i * i);
      Inc(i);
    };
}

function Check(n: Integer): result Integer;
{
  if n > 3 Result := error('too big at ' + IntToStr(n)); else Result := n;
}

function Sum: result Integer;
val n := 0;
{
  Result := 0;
  loop
    {
      Inc(n);
      val x := try Check(n);               {* an error ends the loop and the function *}
      {
        Result := ok(x);
      };
    };
}

val
  i := 0;
  raise := 5;                               {* 'raise' is no keyword any more *}
{
  loop
    {
      Inc(i);
      if i = 2 Continue;
      if i > 4 Break;
      Write(i, ' ');
    };
  WriteLn;
  WriteLn('SquareOf: ', FirstSquareAbove(50));
  case Sum of { ok v: WriteLn(v); error e: WriteLn('Error: ', e); };
  i := 0;
  loop
    vao k := TK.Create(i);                  {* a new owner in every iteration *}
    {
      Inc(i);
      if i = 3 Break;
    };
  WriteLn('raise = ', raise);
}
