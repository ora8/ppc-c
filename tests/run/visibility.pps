program visibility;
type
  TBase = class {
  private
    FSecret: Integer;
    procedure Hidden;
  protected
    FShared: Integer;
    procedure Helper;
  public
    constructor Create;
    function Secret: Integer; const;
    property Shared: Integer read FShared;
  }
  TChild = class(TBase) {
  public
    procedure Work;
  }
  TPoint = record {
  private
    FX: Integer;
  public
    procedure SetX(v: Integer);
    function X: Integer; const;
  }
constructor TBase.Create; { FSecret := 42; FShared := 1; Hidden; }
procedure TBase.Hidden; { Inc(FSecret); }
procedure TBase.Helper; { Inc(FShared); }
function TBase.Secret: Integer; const; { Result := FSecret; }
procedure TChild.Work;
  procedure Inner; { Helper; }
{
  Inc(FShared);
  Inner;
  Helper;
}
procedure TPoint.SetX(v: Integer); { FX := v; }
function TPoint.X: Integer; const; { Result := FX; }
val p: TPoint := default;
{
  vao c := TChild.Create;
  {
    c.Work;
    WriteLn(c.Secret, ' ', c.Shared);
  };
  p.SetX(5);
  WriteLn(p.X);
}
