program text_files;
import std;
{
  case TTextFile.OpenWrite('tf_test.tmp') of {
    ok f: { f.WriteLine('first'); f.Write('sec'); f.WriteLine('ond'); };
    error e: WriteLn(e);
  };
  if TTextFile.OpenAppend('tf_test.tmp') is ok f f.WriteLine('third');
  if TTextFile.OpenRead('tf_test.tmp') is ok f
    loop
      {
        if f.ReadLine is some line WriteLn(f.Name, ': ', line); else Break;
      };
  if TTextFile.OpenRead('/no/such/file') is error e WriteLn(e);
  if DeleteFile('tf_test.tmp') is ok WriteLn('removed');
}
