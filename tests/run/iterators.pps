program iterators;
type
  TBag = class;
  TBagEnum = record {
    Bag: var optional TBag;
    I: Integer;
    func MoveNext: Boolean;
    func Current: Integer; const;
  }
  TBag = class {
    Items: array of Integer;
    proc Add(x: Integer);
    func GetEnumerator: TBagEnum;
  }
  TRangeEnum = record {
    Cur, Hi, Step: Integer;
    func MoveNext: Boolean;
    property Current: Integer read Cur;
  }
  TRange = record {
    Lo, Hi, Step: Integer;
    func GetEnumerator: TRangeEnum; const;
  }
  TWordEnum = class {
    Text: String;
    Pos, Start: Integer;
    W: String;
    func MoveNext: Boolean;
    func Current: String; const;
  }
  TWords = record {
    Text: String;
    func GetEnumerator: TWordEnum; const;
  }
func TBagEnum.MoveNext: Boolean
{
  Inc(I);
  Result := False;
  if Bag is some b then Result := I < Length(b.Items);
}
func TBagEnum.Current: Integer; const
{
  Result := 0;
  if Bag is some b then Result := b.Items[I];
}
proc TBag.Add(x: Integer) { SetLength(Items, Length(Items) + 1); Items[High(Items)] := x; }
func TBag.GetEnumerator: TBagEnum
{
  Result.I := -1;
  Result.Bag := Self;
}
func TRangeEnum.MoveNext: Boolean { Cur := Cur + Step; Result := Cur <= Hi; }
func TRange.GetEnumerator: TRangeEnum; const { Result.Cur := Lo - Step; Result.Hi := Hi; Result.Step := Step; }
func Range(lo, hi, step: Integer): TRange { Result.Lo := lo; Result.Hi := hi; Result.Step := step; }
func TWordEnum.MoveNext: Boolean
{
  while (Pos <= Length(Text)) and (Text[Pos] = ' ') do Inc(Pos);
  Start := Pos;
  while (Pos <= Length(Text)) and (Text[Pos] <> ' ') do Inc(Pos);
  W := Copy(Text, Start, Pos - Start);
  Result := Pos > Start;
}
func TWordEnum.Current: String; const { Result := W; }
func TWords.GetEnumerator: TWordEnum; const
{
  Result := TWordEnum.Create;
  Result.Text := Text;
  Result.Pos := 1;
}
val
  w: TWords := (Text: '  the quick  brown fox ');
{
  vao bag := TBag.Create;
  {
    bag.Add(3); bag.Add(5); bag.Add(8);
    for val x in bag do Write(x, ' ');
    WriteLn;
  };
  for val i in Range(1, 10, 3) do Write(i, ' ');
  WriteLn;
  for val word in w do Write('[', word, ']');
  WriteLn;
}
