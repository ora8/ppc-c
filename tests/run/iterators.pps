program iterators;
type
  TBag = class;
  TBagEnum = record {
    Bag: var optional TBag;
    I: Integer;
    function MoveNext: Boolean;
    function Current: Integer; const;
  }
  TBag = class {
    Items: array of Integer;
    procedure Add(x: Integer);
    function GetEnumerator: TBagEnum;
  }
  TRangeEnum = record {
    Cur, Hi, Step: Integer;
    function MoveNext: Boolean;
    property Current: Integer read Cur;
  }
  TRange = record {
    Lo, Hi, Step: Integer;
    function GetEnumerator: TRangeEnum; const;
  }
  TWordEnum = class {
    Text: String;
    Pos, Start: Integer;
    W: String;
    function MoveNext: Boolean;
    function Current: String; const;
  }
  TWords = record {
    Text: String;
    function GetEnumerator: TWordEnum; const;
  }
function TBagEnum.MoveNext: Boolean;
{
  Inc(I);
  Result := False;
  if Bag is some b Result := I < Length(b.Items);
}
function TBagEnum.Current: Integer; const;
{
  Result := 0;
  if Bag is some b Result := b.Items[I];
}
procedure TBag.Add(x: Integer); { SetLength(Items, Length(Items) + 1); Items[High(Items)] := x; }
function TBag.GetEnumerator: TBagEnum;
{
  Result.I := -1;
  Result.Bag := Self;
}
function TRangeEnum.MoveNext: Boolean; { Cur := Cur + Step; Result := Cur <= Hi; }
function TRange.GetEnumerator: TRangeEnum; const; { Result.Cur := Lo - Step; Result.Hi := Hi; Result.Step := Step; }
function Range(lo, hi, step: Integer): TRange; { Result.Lo := lo; Result.Hi := hi; Result.Step := step; }
function TWordEnum.MoveNext: Boolean;
{
  while (Pos <= Length(Text)) and (Text[Pos] = ' ') do Inc(Pos);
  Start := Pos;
  while (Pos <= Length(Text)) and (Text[Pos] <> ' ') do Inc(Pos);
  W := Copy(Text, Start, Pos - Start);
  Result := Pos > Start;
}
function TWordEnum.Current: String; const; { Result := W; }
function TWords.GetEnumerator: TWordEnum; const;
{
  Result := TWordEnum.Create;
  Result.Text := Text;
  Result.Pos := 1;
}
val
  w: TWords := (Text: '  the quick  brown fox ');
{
  vao bag := TBag.Create;
  {
    bag.Add(3); bag.Add(5); bag.Add(8);
    for val x in bag do Write(x, ' ');
    WriteLn;
  };
  for val i in Range(1, 10, 3) do Write(i, ' ');
  WriteLn;
  for val word in w do Write('[', word, ']');
  WriteLn;
}
