program StdLibrary;
{* standard library (generics stage 6): import std -> TList, TStack, TMap, Sort, IndexOf *}
import std;
type
  TCustomer = class {
    Name: String;
    constructor Create(AName: String const);
    destructor Destroy; override;
  }
constructor TCustomer.Create(AName: String const); { inherited Create; Name := AName; }
destructor TCustomer.Destroy; { WriteLn('  freed ', Name); inherited Destroy; }

val
  numbers: array of Integer := (5, 3, 9, 1, 7);
  names: array of String := ('Mia', 'Anna', 'Bert');
vao
  customers := TList<TCustomer>.Create;
  stack := TStack<Integer>.Create;
  ages := TMap<String, Integer>.Create;
  map := TMap<Integer, TCustomer>.Create;
{
  Sort(numbers);
  for val i := 0 to High(numbers) do Write(numbers[i], ' ');
  WriteLn;
  Sort(names);
  WriteLn(names[0], ' ', names[1], ' ', names[2]);
  if IndexOf(numbers, 7) is some p WriteLn('7 an Position ', p);
  if IndexOf(numbers, 4) = none WriteLn('4 not found');

  customers.Add(TCustomer.Create('Anna'));
  customers.Add(TCustomer.Create('Bert'));
  customers.Add(TCustomer.Create('Carla'));
  if customers.Get(1) is some k WriteLn('Get(1): ', k.Name);
  if customers.Extract(0) is some k WriteLn('Extract(0): ', k.Name);
  WriteLn('Count: ', customers.Count);

  for val i := 1 to 3 do stack.Push(i * 10);
  if stack.Peek is some t WriteLn('Peek: ', t);
  if stack.Pop is some t WriteLn('Pop: ', t);
  WriteLn('Stack: ', stack.Count, ' empty: ', stack.IsEmpty);

  ages.Put('Bert', 28);
  ages.Put('Anna', 30);
  ages.Put('Carla', 31);
  ages.Put('Anna', 31);
  if ages.Get('Anna') is some a WriteLn('Anna: ', a);
  WriteLn('contains Dora: ', ages.Contains('Dora'), ', Count ', ages.Count);
  if ages.Remove('Bert') is some a WriteLn('Bert removed: ', a);
  WriteLn('Keys[0..1]: ', ages.Keys[0], ' ', ages.Keys[1]);

  map.Put(2, TCustomer.Create('Zwei'));
  map.Put(1, TCustomer.Create('Eins'));
  map.Put(2, TCustomer.Create('Zwei fresh'));    {* the old Two is freed *}
  if map.Get(2) is some k WriteLn('map[2]: ', k.Name);
  WriteLn('End');
}
