program BracesSemicolons;
// the brace syntax: the ";" after a "}" can be left out (after a routine body, a block, between case arms)
type
  TShape = class {
    S: Real;
    constructor Create(AS: Real);
    function Area: Real; virtual; const;
    procedure Grow; virtual;
  }
  TSquare = class(TShape) {
    function Area: Real; override; const;
  }
constructor TShape.Create(AS: Real); { inherited Create; S := AS; }
function TShape.Area: Real; const; { Result := 0; }
procedure TShape.Grow; { S := S * 2; }
function TSquare.Area: Real; override; const; { Result := S * S; }
function Twice(x: Integer): Integer; { Result := 2 * x; }
procedure Hello(name: String);
val greeting := 'Hello, ';
{
  WriteLn(greeting, name);
}
function Old(x: Integer): Integer; { Result := x + 1; };   // a ';' after the '}' is allowed
vao q: TShape := TSquare.Create(3);
{
  Hello('you');
  q.Grow;
  WriteLn(q.Area:0:1, ' ', Twice(4), ' ', Old(1));
  for val i := 1 to 3 do
    case i of {                       // no ';' needed after an arm's '}'
      1: { Write('one'); Write(' ') }
      2: { Write('two'); Write(' ') }
    else WriteLn('three')
    }
}
