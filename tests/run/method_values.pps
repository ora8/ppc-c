program method_values;
import ppc_std;
type
  IGreeter = interface {
    proc Greet(Name: String);
  }
  TPrinter = class(IGreeter) {
    Prefix: String;
    Count: Integer;
    proc Print(x: Integer); virtual;
    func Less(a, b: Integer): Boolean; const;
    proc Greet(Name: String);
    proc Tick;
  }
  TLoud = class(TPrinter) {
    proc Print(x: Integer); override;
  }
  TAcc = record {
    Sum: Integer;
    proc Add(x: Integer);
  }
proc TPrinter.Print(x: Integer) { Inc(Count); WriteLn(Prefix, x); }
func TPrinter.Less(a, b: Integer): Boolean; const { Result := a > b; }
proc TPrinter.Greet(Name: String) { WriteLn('hello ', Name); }
proc TPrinter.Tick { Inc(Count); }
proc TLoud.Print(x: Integer) { Inc(Count); WriteLn(Prefix, x, '!'); }
proc TAcc.Add(x: Integer) { Sum := Sum + x; }

proc ForEach(a: array of Integer; Visit: reference to proc(x: Integer))
{
  for val x in a do Visit(x);
}
proc Twice(Action: reference to proc)
{
  Action;
  Action();
}
proc Call(Hello: reference to proc(Name: String)) { Hello('Anna'); }

val
  nums: array of Integer := (3, 1, 2);
  acc: TAcc := default;
{
  vao p := TPrinter.Create;
  vao l := TLoud.Create;
  {
    p.Prefix := '- ';
    l.Prefix := '* ';
    ForEach(nums, p.Print);
    ForEach(nums, l.Print);
    SortBy(nums, p.Less);
    for val x in nums do Write(x, ' ');
    WriteLn;
    Twice(p.Tick);
    WriteLn(p.Count, ' ', l.Count);
    ForEach(nums, acc.Add);
    WriteLn(acc.Sum);
    var g: IGreeter := p;
    {
      Call(g.Greet);
    };
  };
}
