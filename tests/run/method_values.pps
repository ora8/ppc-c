program method_values;
import std;
type
  IGreeter = interface {
    procedure Greet(Name: String);
  }
  TPrinter = class(IGreeter) {
    Prefix: String;
    Count: Integer;
    procedure Print(x: Integer); virtual;
    function Less(a, b: Integer): Boolean; const;
    procedure Greet(Name: String);
    procedure Tick;
  }
  TLoud = class(TPrinter) {
    procedure Print(x: Integer); override;
  }
  TAcc = record {
    Sum: Integer;
    procedure Add(x: Integer);
  }
procedure TPrinter.Print(x: Integer); { Inc(Count); WriteLn(Prefix, x); }
function TPrinter.Less(a, b: Integer): Boolean; const; { Result := a > b; }
procedure TPrinter.Greet(Name: String); { WriteLn('hello ', Name); }
procedure TPrinter.Tick; { Inc(Count); }
procedure TLoud.Print(x: Integer); { Inc(Count); WriteLn(Prefix, x, '!'); }
procedure TAcc.Add(x: Integer); { Sum := Sum + x; }

procedure ForEach(a: array of Integer; Visit: reference to procedure(x: Integer));
{
  for val x in a do Visit(x);
}
procedure Twice(Action: reference to procedure);
{
  Action;
  Action();
}
procedure Call(Hello: reference to procedure(Name: String)); { Hello('Anna'); }

val
  nums: array of Integer := (3, 1, 2);
  acc: TAcc := default;
{
  vao p := TPrinter.Create;
  vao l := TLoud.Create;
  {
    p.Prefix := '- ';
    l.Prefix := '* ';
    ForEach(nums, p.Print);
    ForEach(nums, l.Print);
    SortBy(nums, p.Less);
    for val x in nums do Write(x, ' ');
    WriteLn;
    Twice(p.Tick);
    WriteLn(p.Count, ' ', l.Count);
    ForEach(nums, acc.Add);
    WriteLn(acc.Sum);
    var g: IGreeter := p;
    {
      Call(g.Greet);
    };
  };
}
