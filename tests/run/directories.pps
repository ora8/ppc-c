program directories;
import ppc_std;
val base := 'ppc_dir_test.tmp';
{
  if ForceDirs(JoinPath(base, 'a/b/c')) is error e WriteLn(e);
  if CreateDir(JoinPath(base, 'x')) is ok WriteLn('created x');
  if CreateDir(JoinPath(base, 'x')) is error e WriteLn('again: ', Copy(e, 1, 27));
  if WriteFile(JoinPath(base, 'notes.txt'), 'hello') is ok WriteLn('written');
  val r := ListDir(base);
  {
    if r is ok names for val n in names do WriteLn('  ', n, ' ', DirExists(JoinPath(base, n)));
  };
  if FileSize(JoinPath(base, 'notes.txt')) is ok sz WriteLn('size ', sz);
  if RenameFile(JoinPath(base, 'notes.txt'), JoinPath(base, 'n2.txt')) is ok WriteLn('renamed ', FileExists(JoinPath(base, 'n2.txt')));
  if ListDir('/no/such/dir') is error e WriteLn(e);
  WriteLn(ExtractFileName('src/main.pas'), ' ', ExtractFileDir('src/main.pas'), ' ', ExtractFileExt('src/main.pas'), ' ',
          ChangeFileExt('src/main.pas', '.c'), ' [', ExtractFileExt('.bashrc'), '] ', ExtractFileDir('/x'), ' ', JoinPath('a/', 'b'));
  val here := CurrentDir;
  {
    if SetCurrentDir(base) is ok WriteLn('in ', ExtractFileName(CurrentDir));
    if SetCurrentDir(here) is ok WriteLn('back');
  };
  if DeleteFile(JoinPath(base, 'n2.txt')) is ok then;
  val dirs: array of String := ('a/b/c', 'a/b', 'a', 'x', '');
  {
    for val d in dirs do
      if RemoveDir(JoinPath(base, d)) is error e WriteLn(e);
  };
  WriteLn(DirExists(base));
}
