program class_references;
type
  TShape = class {
    Size: Integer;
    constructor Create(ASize: Integer); virtual;
    function Area: Integer; virtual;
    class function Kind: String;
  }
  TShapeClass = class of TShape;
  TSquare = class(TShape) {
    constructor Create(ASize: Integer); override;
    function Area: Integer; override;
  }
  TCircle = class(TShape) {
    function Area: Integer; override;
  }
constructor TShape.Create(ASize: Integer); { Size := ASize; }
function TShape.Area: Integer; { Result := 0; }
class function TShape.Kind: String; { Result := 'shape'; }
constructor TSquare.Create(ASize: Integer); { inherited Create(ASize); WriteLn('square ', ASize, ' created'); }
function TSquare.Area: Integer; { Result := Size * Size; }
function TCircle.Area: Integer; { Result := 3 * Size * Size; }

function Make(c: TShapeClass; n: Integer): TShape;
{
  Result := c.Create(n);
}

val
  kinds: array of TShapeClass := (TSquare, TCircle, TShape);
  c: TShapeClass := TCircle;
{
  for val k in kinds do
  {
    vao s := Make(k, 2);
    {
      WriteLn(k.ClassName, ' ', s.ClassName, ' ', s.Area, ' ', s.ClassType = k, ' ', s is TCircle);
    };
  };
  vao x := c.Create(3);
  {
    WriteLn(x.Area, ' ', x is c, ' ', c.Kind, ' ', c = TCircle, ' ', c <> TSquare);
    c := x.ClassType;
    WriteLn(c.ClassName);
  };
}
