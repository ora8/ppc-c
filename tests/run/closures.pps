program closures;
type
  TCounter = class {
    Count: Integer;
    Step: Integer;
    procedure Run(n: Integer);
  }

procedure ForEach(a: array of Integer; Visit: reference to procedure(x: Integer));
{
  for val x in a do Visit(x);
}

function CountIf(a: array of Integer; Keep: reference to function(x: Integer): Boolean): Integer;
{
  Result := 0;
  for val x in a do
    if Keep(x) Inc(Result);
}

function IsEven(x: Integer): Boolean;
{
  Result := not Odd(x);
}

procedure TCounter.Run(n: Integer);
val a: array of Integer := default;
{
  SetLength(a, n);
  for val i := 0 to n - 1 do a[i] := i + 1;
  ForEach(a, procedure(x: Integer) { Count := Count + x * Step; });
}

procedure Demo(Limit: Integer);
val
  a: array of Integer := (1, 5, 8, 12, 3);
  Sum := 0;
  Prefix := 'item ';
  procedure Show(x: Integer);
  {
    WriteLn(Prefix, x);
  }
{
  ForEach(a, procedure(x: Integer) { Sum := Sum + x; });
  WriteLn('sum ', Sum);
  WriteLn('above ', Limit, ': ', CountIf(a, function(x: Integer): Boolean { Result := x > Limit; }));
  WriteLn('even: ', CountIf(a, IsEven));
  ForEach(a, Show);
  val Twice: reference to function(x: Integer): Integer := function(x: Integer): Integer { Result := x * 2 + Sum; };
  {
    WriteLn(Twice(1));
    Sum := 100;
    WriteLn(Twice(1));
  };
}

{
  Demo(4);
  vao c := TCounter.Create;
  {
    c.Step := 10;
    c.Run(3);
    WriteLn(c.Count);
  };
}
