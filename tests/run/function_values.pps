program FunctionValues;
{* function types, routines as values, lambdas *}
type
  TCompare = function(a, b: Integer): Integer;
  TAction = procedure(x: Integer);

val Total: Integer := 0;

function Desc(a, b: Integer): Integer; { Result := b - a; }
procedure Add(x: Integer); { Total := Total + x; }
function Tick: Integer; { Result := 7; }

procedure ForEach(a: array of Integer; act: TAction);
{
  for val i := 0 to High(a) do act(a[i]);
}

function Apply(f: function(x: Integer): Integer; v: Integer): Integer;
{ Result := f(v); }

function Pick(up: Boolean): TCompare;
{
  if up Result := function(a, b: Integer): Integer { Result := a - b; }
  else Result := Desc;
}

val
  nums: array of Integer := (3, 1, 2);
  cmp: TCompare := Desc;
  t: function: Integer := Tick;
{
  WriteLn(cmp(1, 5), ' ', Pick(True)(1, 5), ' ', t());
  ForEach(nums, Add);
  WriteLn('Total ', Total);
  ForEach(nums, procedure(x: Integer) { Write(x * 10, ' '); });
  WriteLn;
  WriteLn(Apply(function(x: Integer): Integer { Result := x * x; }, 9));
  cmp := Pick(False);
  WriteLn(cmp(2, 9));
}
