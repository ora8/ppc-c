program CloneDemo;
{* Clone: an explicit deep copy, generated by the compiler with '; auto;' *}
type
  TAddress = class
    City: String;
    constructor Create(ACity: String const);
    destructor Destroy; override;
    function Clone: TAddress; const; auto;
  end;
  TPerson = class
    Name: String;
    Address: optional TAddress;            {* owned: is cloned along *}
    Boss: var optional TPerson;            {* reference: still points to the same one *}
    Children: array[1..2] of optional TPerson;
    constructor Create(AName: String const);
    destructor Destroy; override;
    function Clone: TPerson; const; virtual; auto;
  end;
  TEmployee = class(TPerson)
    Nr: Integer;
    Office: optional TAddress;
  end;
  TPair = record
    A, B: optional TAddress;
    Info: String;
    function Clone: TPair; const; auto;
  end;

constructor TAddress.Create(ACity: String const); begin inherited Create; City := ACity; end;
destructor TAddress.Destroy; begin WriteLn('  freed Address ', City); inherited Destroy; end;
constructor TPerson.Create(AName: String const); begin inherited Create; Name := AName; end;
destructor TPerson.Destroy; begin WriteLn('  freed ', Name); inherited Destroy; end;

vao boss := TPerson.Create('Boss');

procedure Local;
vao
  anna := TPerson.Create('Anna');
begin
  anna.Address := TAddress.Create('Bern');
  anna.Boss := boss;
  anna.Children[1] := TPerson.Create('Child');
  vao dup := anna.Clone;
  begin
    dup.Name := 'Anna2';
    if dup.Address is some a then a.City := 'Basel';
    if anna.Address is some a then WriteLn('Original: ', a.City);
    if dup.Boss is some c then WriteLn('Boss of the copy: ', c.Name);
    if dup.Children[1] is some k then WriteLn('Child of the copy: ', k.Name);
  end;
  WriteLn('-- end of Local');
end;

procedure Poly;
vao
  m := TEmployee.Create('Max');
begin
  m.Nr := 7;
  m.Office := TAddress.Create('Zug');
  var p: TPerson := m;
  begin
    vao k := p.Clone;                       {* whole object, also the TEmployee fields *}
    begin
      WriteLn('Class: ', k.ClassName);
      if k is TEmployee then WriteLn('Nr: ', (k as TEmployee).Nr);
    end;
  end;
end;

procedure RecordClone;
val
  p: TPair := default;
  q: TPair := default;
begin
  p.A := TAddress.Create('Chur');
  p.Info := 'x';
  q := p.Clone;
  if q.A is some a then a.City := 'Thun';
  if p.A is some a then WriteLn('Record-Original: ', a.City);
end;

begin
  Local;
  Poly;
  RecordClone;
end.
