program overloads_iface_generic;
type
  IPrinter = interface {
    procedure Print(s: String);
  }
  TPrinter = class(IPrinter) {
    procedure Print(i: Integer); overload;
    procedure Print(s: String); overload;
  }
  TBox<T> = class {
    V: optional T;
    procedure Put(vao x: T); overload;
    procedure Put(vao x: T; Twice: Boolean); overload;
  }
procedure TPrinter.Print(i: Integer); { WriteLn('int ', i); }
procedure TPrinter.Print(s: String); { WriteLn('str ', s); }
procedure TBox<T>.Put(vao x: T); { V := x; }
procedure TBox<T>.Put(vao x: T; Twice: Boolean); { V := x; if Twice WriteLn('twice'); }
procedure Use(var p: IPrinter); { p.Print('via interface'); }
{
  vao p := TPrinter.Create;
  vao b := TBox<Integer>.Create;
  {
    p.Print(3);
    p.Print('three');
    var q: IPrinter := p;
    { Use(q); };
    b.Put(5);
    b.Put(6, True);
    if b.V is some v WriteLn(v);
  };
}
