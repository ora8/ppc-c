program overloads;
type
  TShape = class {
    constructor Create; overload;
    constructor Create(AName: String); overload;
    function Describe: String; overload; virtual;
    function Describe(Prefix: String): String; overload;
    Name: String;
  }
  TCircle = class(TShape) {
    R: Real;
    function Describe: String; override;
    function Describe(Times: Integer): String; overload;
  }
  TVec = record {
    X, Y: Real;
    procedure Add(d: Real); overload;
    procedure Add(v: TVec); overload;
  }
function DupeStr(s: String; n: Integer): String;
{ Result := ''; for val i := 1 to n do Result := Result + s; }
constructor TShape.Create; { Name := 'shape'; }
constructor TShape.Create(AName: String); { Name := AName; }
function TShape.Describe: String; { Result := 'a ' + Name; }
function TShape.Describe(Prefix: String): String; { Result := Prefix + Describe; }
function TCircle.Describe: String; { Result := 'circle ' + Name; }
function TCircle.Describe(Times: Integer): String; { Result := DupeStr(Describe, Times); }
procedure TVec.Add(d: Real); { X := X + d; Y := Y + d; }
procedure TVec.Add(v: TVec); { X := X + v.X; Y := Y + v.Y; }

function Show(i: Integer): String; overload; forward;
function Show(s: String): String; overload;
{ Result := 'string ' + s; }
function Show(r: Real): String; overload;
{ Result := 'real ' + FloatToStr(r); }
function Show(i: Integer): String;
{ Result := 'integer ' + IntToStr(i); }
function Show(a, b: Integer): String; overload;
{ Result := 'two ' + IntToStr(a + b); }
function Show: String; overload;
{ Result := 'nothing'; }
procedure Bump(var i: Integer); overload; { Inc(i); }
procedure Bump(var s: String); overload; { s := s + '+'; }

val
  i := 41;
  s := 'xy';
  v: TVec := (X: 1; Y: 2);
  w: TVec := (X: 10; Y: 20);
{
  WriteLn(Show(5));
  WriteLn(Show('hi'));
  WriteLn(Show(2.5));
  WriteLn(Show('c'));
  WriteLn(Show(1, 2));
  WriteLn(Show);
  Bump(i); Bump(s);
  WriteLn(i, ' ', s);
  v.Add(1);
  v.Add(w);
  WriteLn(v.X:0:0, ' ', v.Y:0:0);
  vao a := TShape.Create;
  vao b := TShape.Create('box');
  vao c := TCircle.Create('ring');
  {
    WriteLn(a.Describe, ' / ', b.Describe('-> '));
    WriteLn(c.Describe, ' / ', c.Describe('* '), ' / ', c.Describe(2));
  };
}
