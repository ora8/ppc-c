program Results;
{* errors as return values: 'result T' (like Result<T, E> in Rust) *}
type
  TError = (NoError, DivByZero, TooBig);
  TPoint = record {
    X, Y: Integer;
  }
  TCounter = class {
    N: Integer;
    destructor Destroy; override;
  }

destructor TCounter.Destroy; { WriteLn('  freed: Counter ', N); inherited Destroy; }

function Divide(a, b: Integer): result Integer;          {* error: String *}
{
  if b = 0 Result := error('division by 0');
  else Result := a div b;                               {* Value = ok(...) *}
}

function Check(n: Integer): result of TError;         {* no value, only success or error *}
{
  if n > 100 Result := error(TooBig); else Result := ok;
}

function Compute(a, b, c: Integer): result Integer;
vao z := TCounter.Create;                               {* is freed on an error too *}
{
  val q := try Divide(a, b);                             {* error -> return at once *}
  {
    z.N := q;
    Result := try Divide(q, c);
    Result := ok(q * 10);
  };
}

function Chain(n: Integer): result of TError;
{
  try Check(n);                                        {* statement: only the error counts *}
  try Check(n * 2);
  WriteLn('  Chain ok for ', n);
}

function MakePoint(ok_: Boolean): result TPoint;
{
  if ok_ Result := (X: 1; Y: 2); else Result := error('no MakePoint');
}

val r := Divide(10, 2);
{
  if r is ok v WriteLn('10 / 2 = ', v);
  case Divide(1, 0) of {
    ok v: WriteLn('Value ', v);
    error e: WriteLn('Error: ', e);
  };
  WriteLn('ValueOr: ', Divide(7, 0).ValueOr(-1), ' ', Divide(7, 7).ValueOr(-1));
  WriteLn('IsOk: ', Divide(1, 1).IsOk, ', IsError: ', Divide(1, 0).IsError);
  WriteLn('-- try');
  case Compute(100, 5, 2) of { ok v: WriteLn('Compute = ', v); error e: WriteLn('Error: ', e); };
  case Compute(100, 0, 2) of { ok v: WriteLn('Compute = ', v); error e: WriteLn('Error: ', e); };
  case Compute(100, 5, 0) of { ok v: WriteLn('Compute = ', v); error e: WriteLn('Error: ', e); };
  WriteLn('-- without a value');
  if Chain(10) is ok WriteLn('  ok');
  if Chain(60) is error f WriteLn('  Error ', Ord(f));
  case Check(500) of {
    ok: WriteLn('  fits');
    error f: WriteLn('  too big: ', f = TooBig);
  };
  WriteLn('-- Record');
  if MakePoint(True) is ok p WriteLn('  (', p.X, ',', p.Y, ')');
  if MakePoint(False) is error e WriteLn('  ', e);
}
