program CaseExpressions2;
{* case expressions: nested, with guards, moves in arms, in a lambda *}
type TShape = (Circle(Radius: Real), Named(Name: String), Empty);
  TK = class { V: Integer; constructor Create(AV: Integer); }
constructor TK.Create(AV: Integer); { inherited Create; V := AV; }
function Eat(vao k: TK): Integer; { Result := k.V; }
function Up(x: String): String; { Result := UpperCase(x) + '!'; }
function Label(s: TShape): String;
{
  Result := case s of {
    Named(n) when Length(n) > 3: Up(n) + Up(case Length(n) of { 4: 'four' else 'long' });
    Named(n): Up(n);
    Circle(r): FloatToStr(r);
    Empty: ''
  };
}
procedure P(s: TShape);
vao k := TK.Create(5);
{
  WriteLn(case s of { Circle(r) when r > 1: Eat(k); Circle: Eat(k) + 1 else 0 });
}
function Apply(f: reference to function(x: Integer): String; x: Integer): String; { Result := f(x); }
procedure L(limit: Integer);
{
  WriteLn(Apply(function(x: Integer): String { Result := case x of { 0: 'zero' else (case x > limit of { True: 'big' else 'small' }) }; }, 7));
}
{
  for val i := 1 to 3 do WriteLn(Label(Named('abcd')), ' ', Label(Named('ab')), ' ', Label(Named('abcdefg')), ' [', Label(Empty), ']');
  P(Circle(2.0)); P(Circle(0.5)); P(Empty);
  L(5); L(10);
}
