module braces_shapes;
// a module in the brace syntax: it ends with the file
interface
type
  TShape = class {
    Name: String;
    constructor Create(AName: String);
    function Area: Real; virtual; const;
  }
  TSquare = class(TShape) {
    S: Real;
    constructor Create(AS: Real);
    function Area: Real; override; const;
  }
  TPoint = record { X, Y: Integer; }
function Twice(x: Integer): Integer;
implementation
constructor TShape.Create(AName: String); { inherited Create; Name := AName; }
function TShape.Area: Real; const; { Result := 0; }
constructor TSquare.Create(AS: Real); { inherited Create('square'); S := AS; }
function TSquare.Area: Real; const; { Result := S * S; }
function Twice(x: Integer): Integer; { Result := 2 * x; }
